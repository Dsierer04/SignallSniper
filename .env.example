# Copy to .env and fill in. Never commit .env.

# --- REQUIRED ---------------------------------------------------------------
# SEC mandates a declaring User-Agent with real contact info. Anonymous polling
# gets throttled and then IP-blocked, and being blocked at 16:05 on earnings day
# is the dumbest possible way to lose this edge.
SEC_USER_AGENT="Your Name you@example.com"

# --- feeds ------------------------------------------------------------------
SEC_RATE=6.0            # req/s against SEC. Their hard cap is 10. Stay under.
EDGAR_INTERVAL=1.0      # seconds between EDGAR polls (304s are nearly free)
WIRE_INTERVAL=2.0
WIRE_RATE=4.0
ENABLE_WIRES=true

# --- market data ------------------------------------------------------------
# ALPACA_FEED: "iex" is free but only ~2% of consolidated volume -- after-hours
# prints are too thin to reference against, so the 16:05 earnings window will
# produce confident nonsense on it. Use "sip" for that window.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex
ALPACA_PAPER=true

# Massive (formerly Polygon.io -- renamed 2025-10-30; api.polygon.io still works)
POLYGON_API_KEY=

# --- risk -------------------------------------------------------------------
EQUITY=25000            # set honestly; every position sizes off this
RISK_PER_TRADE=0.01     # fraction of equity risked to the stop
MAX_DAILY_LOSS=0.03     # kill switch; sticky once tripped
MAX_CONCURRENT=4

# --- execution --------------------------------------------------------------
# Must be explicitly true AND `watch --live` passed. Risk manager still vetoes.
LIVE_TRADING=false

# --- legacy Reddit scraper (not in the trading path) -------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
